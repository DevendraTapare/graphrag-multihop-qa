APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
# Replace locally. Never commit a real password. At least 12 characters.
NEO4J_PASSWORD=replace-with-local-random-secret
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_CONNECTION_TIMEOUT=3
NEO4J_QUERY_TIMEOUT=5
NEO4J_IMPORT_TIMEOUT=60
NEO4J_POOL_SIZE=10
NEO4J_WRITE_RETRY_TIME=3
INGESTION_MAX_BYTES=65536
INGESTION_CHUNK_SIZE=600
INGESTION_CHUNK_OVERLAP=80
INGESTION_BATCH_SIZE=20
INGESTION_LEASE_SECONDS=300
EMBEDDING_STARTUP_TIMEOUT=180
EMBEDDING_INFERENCE_TIMEOUT=30
VECTOR_CORPUS=fictional-v1
VECTOR_QUERY_TIMEOUT=20
GRAPH_QUERY_TIMEOUT=10
GRAPH_REQUEST_TIMEOUT=20
GRAPH_MAX_CANDIDATES=128
GRAPH_MAX_ANSWERS=10
STAGE5_NEO4J_URI=bolt://127.0.0.1:17688
STAGE5_HTTP_PORT=17475
STAGE5_BOLT_PORT=17688
HYBRID_REQUEST_TIMEOUT=60
